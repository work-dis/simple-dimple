# Список VPS с control-plane для deploy/manual-deploy.sh — скопируй в
# deploy/ssh.env (не коммитится, см. .gitignore) и подставь реальные
# хосты/креды. Скрипт деплоит на КАЖДЫЙ хост из CP_HOSTS по очереди за один
# запуск (Decision 043, docs/DECISIONS.md) — раньше деплоился только один
# VPS_IP, и второй известный хост с control-plane (Decision 042) незаметно
# отставал/оставался без свежих фиксов.
#
# Формат одной строки — "ip:user:password[:domain]":
#   ip       — адрес VPS для ssh И одновременно значение по умолчанию для
#              CONTROL_PLANE_DOMAIN этого хоста (см. ниже), если 4-е поле
#              не задано.
#   user     — ssh-пользователь.
#   password — если пусто (":user:@..." — три двоеточия подряд быть не
#              должно, просто оставь поле между двоеточиями пустым:
#              "ip:user::domain") — используется обычный ssh-ключ/agent, без
#              sshpass. Если задан — скрипту нужен установленный `sshpass`
#              (brew install sshpass / apt install sshpass), т.к. голый
#              ssh/rsync не поддерживают non-interactive password auth.
#   domain   — необязательно. CONTROL_PLANE_DOMAIN именно для ЭТОГО хоста
#              (deploy/Caddyfile, TLS — см. Decision 040/041). Если не
#              задан, скрипт использует ip. ВАЖНО: должен совпадать с тем,
#              как ты будешь заходить на control-plane этого хоста — либо
#              голый IP (self-signed `tls internal`), либо реальный домен с
#              A-записью на этот IP (настоящий Let's Encrypt, нужен
#              ACME_EMAIL в deploy/.env).
#
# Пример (два VPS, оба password-auth, оба пока без домена — self-signed):
CP_HOSTS=(
  "203.0.113.10:ubuntu:CHANGE_ME"
  "203.0.113.20:root:CHANGE_ME"
)
