{
  "name": "backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "npm run prisma:generate && tsc -p tsconfig.json",
    "build:ci": "tsc -p tsconfig.json",
    "prisma:generate": "rm -rf src/generated/prisma && npx prisma generate",
    "prisma:migrate": "npx prisma migrate deploy --config prisma.config.ts",
    "prisma:validate": "npx prisma validate",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run prisma:generate && npm run prisma:validate && npm run typecheck",
    "check:ci": "npm run prisma:validate && npm run typecheck"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.6.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.15",
    "prisma": "^7.8.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
